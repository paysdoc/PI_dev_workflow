{
  "name": "pi-dev-workflow",
  "version": "0.1.0",
  "description": "Node TypeScript project with Vitest unit tests and Cucumber BDD",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "cross-env NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:all": "npm run test && npm run test:bdd"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typebox": "^1.3.27",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
