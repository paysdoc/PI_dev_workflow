{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    ".pi/extensions/skill-path-guard/**/*.ts",
    ".pi/extensions/plan-issue/**/*.ts",
    ".pi/extensions/write-scenarios/**/*.ts",
    ".pi/extensions/implement-tdd/**/*.ts",
    ".pi/extensions/shared/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
